{
  "name": "expo-base",
  "version": "3.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "prepare": "husky",
    "start": "expo start",
    "start -c": "expo start -c",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "android:release": "expo run:android --variant Release",
    "android:dev-build": "eas build --profile development --platform android",
    "android:dev-build:local": "eas build --profile development --platform android --local",
    "android:preview": "eas build --profile preview --platform android",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --variant Release",
    "ios:dev-build": "eas build --profile development --platform ios",
    "ios:dev-build:local": "eas build --profile development --platform ios --local",
    "ios:preview": "eas build --profile preview --platform ios",
    "web": "expo start --web",
    "typecheck": "tsc",
    "lint": "eslint ./src ./e2e --fix",
    "test": "jest --watchAll",
    "e2e:ios:build": "detox build -c ios.release",
    "e2e:ios:test": "detox test -c ios.release",
    "e2e:ios:debug:build": "detox build -c ios.debug",
    "e2e:ios:debug:test": "detox test -c ios.debug",
    "e2e:android:build": "detox build -c android.release",
    "e2e:android:test": "detox test -c android.release",
    "e2e:android:debug:build": "detox build -c android.debug",
    "e2e:android:debug:test": "detox test -c android.debug"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-community/netinfo": "12.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "2.3.2",
    "@testing-library/react-native": "^14.0.1",
    "axios": "^1.18.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@config-plugins/detox": "^11.0.0",
    "@react-native/jest-preset": "^0.86.0",
    "@types/glob": "^9.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "commitlint": "^21.2.1",
    "detox": "^20.51.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-universe": "^16.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.2.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "sharp-cli": "^5.2.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "yarn lint"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "resolutions": {
    "@config-plugins/detox/expo-build-properties": "~57.0.7"
  }
}
